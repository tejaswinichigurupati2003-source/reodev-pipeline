# Copy to .env and fill in. Never commit .env.
# On Vercel, add the same names under Project -> Settings -> Environment Variables.

# Step 2 (LLM extraction, via OpenRouter)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.8-flash

# Step 4 (contacts). auto = Apollo first, Hunter as fallback. Or apollo / hunter. Fill in at least one key.
CONTACT_PROVIDER=auto
APOLLO_API_KEY=
HUNTER_API_KEY=

# Neon Postgres connection string (Neon dashboard -> Connect -> use the POOLED string).
# Empty = a local SQLite file is used instead.
DATABASE_URL=

# Dashboard (app.py). It refuses to start without a password. Use a long random SECRET_KEY.
DASHBOARD_PASSWORD=
SECRET_KEY=
