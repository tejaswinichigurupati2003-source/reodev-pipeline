# Copy to .env and fill in. Never commit .env.
# On Vercel, add the same names under Project -> Settings -> Environment Variables.

# Step 2 (LLM extraction, via OpenRouter)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.8-flash

# Step 4 (contacts). auto = tries Apollo, Prospeo, Hunter in that order, skipping any without a key. Or force one.
CONTACT_PROVIDER=auto
APOLLO_API_KEY=
HUNTER_API_KEY=
PROSPEO_API_KEY=

# Name used to sign the email DRAFTS (drafts are never sent by this project)
SENDER_NAME=

# Neon Postgres connection string (Neon dashboard -> Connect -> use the POOLED string).
# Empty = a local SQLite file is used instead.
DATABASE_URL=

# Dashboard (app.py). It refuses to start without a password. Use a long random SECRET_KEY.
DASHBOARD_PASSWORD=
SECRET_KEY=

# Secret for the private research-responses page (open /responses?key=...)
RESPONSES_KEY=
# Optional: shown on the research form so people can ask questions
RESEARCH_CONTACT_EMAIL=
